# Copy this file to .env and fill in ONE of the keys.
# .env is gitignored; never commit real keys.

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, local vLLM)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides
# JOBHUNT_LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
